---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadForm from '../components/LeadForm.astro';
import CanalHero from '../components/art/CanalHero.astro';
import GuideUs from '../components/art/GuideUs.astro';
import GuideIncome from '../components/art/GuideIncome.astro';
import GuideTax from '../components/art/GuideTax.astro';
import { site } from '../config/site';

const trust = [
  { t: 'Not a bank, not an adviser', d: 'We introduce you to an independent mortgage adviser. We never give advice ourselves.', i: '<circle cx="6" cy="12" r="3"/><circle cx="18" cy="12" r="3"/><path d="M9 12h6"/>' },
  { t: 'One partner, nobody else', d: 'Your details go to a single advisory partner. Never sold, never shared further.', i: '<circle cx="9" cy="8" r="4"/><path d="M2 21c0-4 3-6 7-6s7 2 7 6"/><path d="M16 11l2 2 4-4"/>' },
  { t: 'Anywhere in the Netherlands', d: 'The advisers work nationwide, wherever you plan to buy.', i: '<path d="M9 4 3 6v14l6-2 6 2 6-2V4l-6 2z"/><path d="M9 4v14M15 6v14"/>' },
  { t: 'Plain English', d: 'Every Dutch term is explained the first time we use it.', i: '<path d="M4 6h16M4 12h10M4 18h13"/>' },
];

const situations = [
  { t: 'US citizen or dual national', d: "Dutch banks handle FATCA differently. Some ask for a US TIN or a certificate of loss of nationality (CLN); others don't.", l: 'FATCA, TIN and CLN per lender →', href: '/guides/fatca-tin-cln-dutch-lenders/', i: '<path d="M5 21V4"/><path d="M5 4h12l-2 4 2 4H5"/>' },
  { t: 'Paid in dollars or another currency', d: 'Banks typically count 90% of non-euro income, converted to euros, when they work out your maximum mortgage.', l: 'Mortgage on a non-euro income →', href: '/guides/mortgage-on-usd-income/', i: '<circle cx="12" cy="12" r="9"/><path d="M15 9.5c-.5-1.2-1.7-2-3-2-1.7 0-3 1-3 2.3 0 3 6 1.7 6 4.7 0 1.3-1.3 2.3-3 2.3-1.3 0-2.5-.8-3-2"/><path d="M12 5.5v2M12 16.8v1.7"/>' },
  { t: 'On the expat ruling', d: 'The tax-free allowance drops from 30% to 27% on 1 January 2027, with transitional rules for people who used it before 2024.', l: 'The expat ruling and your mortgage →', href: '/guides/expat-ruling-mortgage/', i: '<path d="M19 5 5 19"/><circle cx="7" cy="7" r="2.5"/><circle cx="17" cy="17" r="2.5"/>' },
  { t: 'New to the Dutch market', d: 'From the first viewing to the notary: what happens when, and who does what.', l: 'Step-by-step buying guide →', href: '/guides/buying-a-home-in-the-netherlands/', i: '<path d="M3 11 12 4l9 7"/><path d="M5 10v10h14V10"/><path d="M10 20v-6h4v6"/>' },
];

const steps = [
  { t: 'Leave three details', d: "Your name, email and phone number. That's all we ask before you press send." },
  { t: 'An adviser contacts you', d: 'An independent mortgage adviser contacts you', verify: site.responseTime },
  { t: "You decide what's next", d: 'The adviser explains your options. Whether you continue is entirely up to you.' },
];

const guides = [
  { cat: 'US citizens', t: 'Can Americans get a mortgage in the Netherlands?', href: site.pillarPath, Art: GuideUs },
  { cat: 'Income', t: 'Getting a mortgage on a USD or other non-euro income', href: '/guides/mortgage-on-usd-income/', Art: GuideIncome },
  { cat: 'Tax', t: 'The expat ruling and your mortgage: from 30% to 27%', href: '/guides/expat-ruling-mortgage/', Art: GuideTax },
];

// Items without an answer stay hidden until the copy is written (VERIFY.md).
const faq: { q: string; a?: string }[] = [
  { q: 'Is My Dutch Door a bank or a mortgage adviser?', a: "No. My Dutch Door is an introduction service. We don't give mortgage advice, compare lenders for you or arrange loans. When you send a request, we pass your name, email and phone number to an independent mortgage advisory partner, whose advisers take it from there." },
  { q: 'What does it cost?' },
  { q: 'What happens to my details?' },
  { q: 'Do I need a permanent residence permit?' },
  { q: "I'm not American. Is My Dutch Door for me?" },
];
const faqShown = faq.filter((f) => f.a);

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqShown.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<BaseLayout
  title="My Dutch Door: a Dutch mortgage, explained in plain English"
  description="For expats buying a home in the Netherlands. Leave your details and an independent mortgage adviser calls you back. We make the introduction; we don't give advice."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqLd)} />

  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero-grid">
      <div class="copy">
        <p class="eyebrow"><span aria-hidden="true" class="dot"></span>For expats buying a home in the Netherlands</p>
        <h1 id="hero-title">A Dutch mortgage, explained in plain English.</h1>
        <p class="lead">Leave your details and an independent mortgage adviser calls you back. We don't give advice ourselves. We make the introduction.</p>
        <ul class="chips" aria-label="Who this is for">
          <li class="chip">US citizens &amp; dual nationals</li>
          <li class="chip">Paid in USD or another currency</li>
          <li class="chip">On the expat ruling</li>
        </ul>
        <a class="readlink" href={site.pillarPath}>New here? Read: Can Americans get a mortgage in the Netherlands?
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>
      </div>
      <LeadForm />
    </div>
    <div class="container art"><CanalHero /></div>
  </section>

  <section class="trust" aria-label="What My Dutch Door is">
    <div class="container trust-grid">
      {trust.map((x) => (
        <div class="trust-item">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#C2410C" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={x.i} />
          <div><p class="tt">{x.t}</p><p class="td">{x.d}</p></div>
        </div>
      ))}
    </div>
  </section>

  <section class="sec" aria-labelledby="sit-title">
    <div class="container">
      <div class="sec-head"><h2 id="sit-title">Your situation, explained</h2><p>Buying as an expat raises questions Dutch buyers never have to ask. Start with the guide that fits you.</p></div>
      <div class="cards4">
        {situations.map((s) => (
          <a class="card" href={s.href}>
            <span class="ico"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={s.i} /></span>
            <span class="ct">{s.t}</span>
            <span class="cd">{s.d}</span>
            <span class="cl">{s.l}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="sec alt" aria-labelledby="how-title">
    <div class="container">
      <div class="sec-row"><h2 id="how-title">How it works</h2><a href="/how-it-works/">More about how it works →</a></div>
      <ol class="steps">
        {steps.map((s, i) => (
          <li>
            <span class="num">{i + 1}</span>
            <h3>{s.t}</h3>
            <p>{s.d}{s.verify && <> <span class="verify">{s.verify}<span class="vnote"> — VERIFY</span></span>.</>}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="us" aria-labelledby="us-title">
    <div class="container us-grid">
      <div class="us-copy">
        <p class="us-eyebrow">For US citizens</p>
        <h2 id="us-title">Americans buy homes here too. The paperwork is just different.</h2>
        <p>Because of FATCA, the US law that makes foreign banks report on American account holders, each Dutch lender sets its own rules for US clients. Some ask for a US TIN or a CLN, some lend if you hold a payment account with them, and some non-bank lenders aren't subject to FATCA obligations at all.</p>
        <a class="us-link" href={site.pillarPath}>Read the guide for Americans
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>
      </div>
      <figure class="stat">
        <p class="big">78,700</p>
        <p class="sd">US nationals lived in the Netherlands on 1 January 2025, up from 60,200 five years earlier.</p>
        <figcaption>Source: CBS (Statistics Netherlands)</figcaption>
      </figure>
    </div>
  </section>

  <section class="sec" aria-labelledby="guides-title">
    <div class="container">
      <div class="sec-row">
        <div class="sec-head tight"><h2 id="guides-title">Guides</h2><p>Written in plain English and reviewed by a licensed mortgage adviser.</p></div>
        <a href="/guides/">All guides →</a>
      </div>
      <div class="cards3">
        {guides.map(({ Art, ...g }) => (
          <a class="gcard" href={g.href}>
            <span class="gart"><Art /></span>
            <span class="gbody">
              <span class="gcat">{g.cat}</span>
              <span class="gt">{g.t}</span>
              <span class="gmeta">Reviewed by <span class="verify">[adviser name]</span> · <span class="verify">[date]</span></span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="sec alt" aria-labelledby="faq-title">
    <div class="container faq-wrap">
      <div class="sec-head"><h2 id="faq-title">Questions people ask first</h2><p>Anything about your own situation is a question for the adviser.</p></div>
      <div class="faq">
        {faqShown.map((f, i) => (
          <details open={i === 0}>
            <summary>{f.q}<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="cta" aria-labelledby="cta-title">
    <div class="container cta-in">
      <div><h2 id="cta-title">Ready to talk it through?</h2><p>An independent mortgage adviser can answer questions about your own situation. You don't need to have found a house yet.</p></div>
      <a class="btn btn-lg" href="#form">Request a call back</a>
    </div>
  </section>
</BaseLayout>

<style>
  h1 { font-size: clamp(36px, 6vw, 58px); line-height: 1.04; font-weight: 700; }
  h2 { font-size: clamp(26px, 3.4vw, 36px); font-weight: 700; }
  .hero { background: var(--paper); overflow: hidden; }
  .hero-grid { display: grid; gap: 40px; grid-template-columns: 1fr; align-items: start; padding-top: 40px; padding-bottom: 32px; }
  @media (min-width: 960px) { .hero-grid { grid-template-columns: 1.1fr 1fr; gap: 64px; padding-top: 72px; padding-bottom: 40px; } }
  .copy { display: flex; flex-direction: column; gap: 24px; padding-top: 8px; }
  .eyebrow { align-self: flex-start; display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px; border-radius: 999px; background: #fff; border: 1px solid var(--line); font-size: 14px; font-weight: 600; color: var(--ink-2); }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent-logo); flex: none; }
  .lead { font-size: 19px; line-height: 1.55; color: var(--ink-2); max-width: 30em; }
  .chips { margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 10px; }
  .readlink { font-size: 16px; font-weight: 600; display: inline-flex; align-items: center; gap: 8px; min-height: 44px; }
  .art { padding-inline: 0; }
  :global(.canal-hero), :global(.guide-art) { display: block; width: 100%; height: auto; }

  .trust { border-bottom: 1px solid var(--line); }
  .trust-grid { display: grid; gap: 24px; padding-block: 32px; grid-template-columns: 1fr; }
  @media (min-width: 720px) { .trust-grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1100px) { .trust-grid { grid-template-columns: repeat(4, 1fr); } }
  .trust-item { display: flex; gap: 14px; align-items: flex-start; }
  .trust-item svg { flex: none; margin-top: 2px; }
  .tt { font-weight: 600; }
  .td { font-size: 15px; color: var(--ink-2); line-height: 1.5; margin-top: 2px; }

  .sec { padding: 56px 0; }
  @media (min-width: 900px) { .sec { padding: 88px 0; } }
  .sec.alt { background: var(--paper); }
  .sec-head { display: flex; flex-direction: column; gap: 10px; max-width: 40em; margin-bottom: 32px; }
  .sec-head.tight { margin-bottom: 0; }
  .sec-head p { color: var(--ink-2); font-size: 18px; }
  .sec-row { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; flex-wrap: wrap; margin-bottom: 32px; }
  .sec-row a { font-weight: 600; display: inline-flex; align-items: center; min-height: 44px; }

  .cards4 { display: grid; gap: 20px; grid-template-columns: 1fr; }
  @media (min-width: 720px) { .cards4 { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1100px) { .cards4 { grid-template-columns: repeat(4, 1fr); } }
  .card { display: flex; flex-direction: column; gap: 10px; padding: 24px; border: 1px solid var(--line); border-radius: 14px; background: #fff; text-decoration: none; color: var(--ink); transition: border-color .15s, box-shadow .15s; }
  .card:hover { border-color: var(--accent); box-shadow: 0 8px 24px rgba(19,35,58,.08); color: var(--ink); }
  .ico { width: 44px; height: 44px; border-radius: 12px; background: var(--accent-soft); color: var(--accent); display: inline-flex; align-items: center; justify-content: center; }
  .ct { font-family: var(--font-head); font-weight: 700; font-size: 20px; line-height: 1.2; }
  .cd { font-size: 15px; color: var(--ink-2); line-height: 1.5; flex: 1; }
  .cl { font-weight: 600; font-size: 15px; color: var(--link); }

  .steps { margin: 0; padding: 0; list-style: none; display: grid; gap: 20px; grid-template-columns: 1fr; }
  @media (min-width: 900px) { .steps { grid-template-columns: repeat(3, 1fr); gap: 32px; } }
  .steps li { background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 28px; display: flex; flex-direction: column; gap: 10px; }
  .num { width: 40px; height: 40px; border-radius: 50%; background: var(--ink); color: #fff; display: inline-flex; align-items: center; justify-content: center; font-family: var(--font-head); font-weight: 700; }
  .steps h3 { font-size: 22px; }
  .steps p { color: var(--ink-2); }

  .us { background: var(--ink); color: #fff; padding: 56px 0; }
  @media (min-width: 900px) { .us { padding: 88px 0; } }
  .us-grid { display: grid; gap: 40px; grid-template-columns: 1fr; align-items: center; }
  @media (min-width: 960px) { .us-grid { grid-template-columns: 1.3fr 1fr; gap: 72px; } }
  .us-copy { display: flex; flex-direction: column; gap: 18px; }
  .us-copy p { color: #dfe6ec; font-size: 18px; }
  .us-copy .us-eyebrow { color: var(--accent-on-dark); font-weight: 600; font-size: 15px; }
  .us-link { color: var(--accent-on-dark); font-weight: 600; display: inline-flex; align-items: center; gap: 8px; min-height: 44px; }
  .us-link:hover { color: #fff; }
  .stat { margin: 0; padding: 32px; border: 1px solid #3a4b63; border-radius: 16px; background: #1a2d47; display: flex; flex-direction: column; gap: 12px; }
  .big { font-family: var(--font-head); font-weight: 700; font-size: clamp(56px, 8vw, 84px); line-height: 1; color: var(--accent-on-dark); }
  .sd { font-size: 18px; color: #fff; }
  figcaption { font-size: 14px; color: #c9d3dd; }

  .cards3 { display: grid; gap: 24px; grid-template-columns: 1fr; margin-top: 8px; }
  @media (min-width: 720px) { .cards3 { grid-template-columns: repeat(3, 1fr); } }
  .gcard { display: flex; flex-direction: column; border: 1px solid var(--line); border-radius: 16px; overflow: hidden; background: #fff; text-decoration: none; color: var(--ink); transition: border-color .15s, box-shadow .15s; }
  .gcard:hover { border-color: var(--accent); box-shadow: 0 8px 24px rgba(19,35,58,.08); color: var(--ink); }
  .gart { display: block; background: var(--paper); padding: 16px 16px 0; border-bottom: 1px solid var(--line); }
  .gbody { display: flex; flex-direction: column; gap: 8px; padding: 22px; }
  .gcat { align-self: flex-start; font-size: 13px; font-weight: 600; padding: 3px 10px; border-radius: 999px; background: var(--accent-soft); color: var(--link); }
  .gt { font-family: var(--font-head); font-weight: 700; font-size: 21px; line-height: 1.2; }
  .gmeta { font-size: 14px; color: var(--muted); }

  .faq-wrap { display: grid; gap: 32px; grid-template-columns: 1fr; }
  @media (min-width: 960px) { .faq-wrap { grid-template-columns: 1fr 1.6fr; gap: 64px; } }
  .faq { display: flex; flex-direction: column; gap: 12px; }
  details { background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 0 22px; }
  summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 16px; min-height: 60px; font-weight: 600; font-size: 18px; }
  summary::-webkit-details-marker { display: none; }
  details[open] summary svg path:first-child { d: path('M5 12h14'); }
  details p { padding-bottom: 22px; color: var(--ink-2); }

  .cta { background: var(--accent-soft); padding: 48px 0; border-top: 1px solid #f6d8c2; }
  .cta-in { display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; }
  .cta-in div { max-width: 40em; display: flex; flex-direction: column; gap: 8px; }
  .cta-in p { color: var(--ink-2); font-size: 18px; }
  .vnote { display: none; }
</style>
