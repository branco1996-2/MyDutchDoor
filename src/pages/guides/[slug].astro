---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../config/site';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((g) => ({ params: { slug: g.id }, props: { guide: g, all: guides } }));
}
const { guide, all } = Astro.props;
const { data } = guide;
const { Content, headings } = await render(guide);
const isStub = data.status === 'stub';
const url = `${site.domain}/guides/${guide.id}/`;
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });

const toc = headings.filter((h) => h.depth === 2 && h.slug !== 'the-short-answer').map((h) => ({ id: h.slug, text: h.text }));
const faq = data.faq.filter((f) => f.a);
if (faq.length) toc.push({ id: 'faq', text: 'FAQ' });
if (data.sources.length) toc.push({ id: 'sources', text: 'Sources' });

const related = data.related.map((id) => all.find((g) => g.id === id)).filter(Boolean) as typeof all;

const crumbs = [{ name: 'Home', href: '/' }, { name: 'Guides', href: '/guides/' }, { name: data.category, href: null }];
const ld: any[] = [
  { '@type': 'BreadcrumbList', itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, ...(c.href ? { item: site.domain + c.href } : {}) })) },
];
if (!isStub) {
  ld.push({
    '@type': 'Article', headline: data.title, description: data.description, mainEntityOfPage: url, inLanguage: 'en',
    // Real names only; falls back to the organisation until author/reviewer are confirmed (VERIFY.md).
    author: data.author ? { '@type': 'Person', name: data.author } : { '@type': 'Organization', name: site.name },
    ...(data.reviewer ? { reviewedBy: { '@type': 'Person', name: data.reviewer.name, jobTitle: data.reviewer.credentials } } : {}),
    ...(data.lastReviewed ? { dateModified: data.lastReviewed.toISOString().slice(0, 10) } : {}),
    publisher: { '@id': `${site.domain}/#org` },
  });
  if (faq.length) ld.push({ '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) });
}
---
<BaseLayout title={`${data.title} | My Dutch Door`} description={data.description} noindex={isStub}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': ld })} />

  <header class="art-head">
    <div class="container head-in">
      <nav aria-label="Breadcrumb" class="crumbs">
        <a href="/">Home</a><span aria-hidden="true">/</span><a href="/guides/">Guides</a><span aria-hidden="true">/</span><span aria-current="page">{data.category}</span>
      </nav>
      <p class="cat">{data.category}</p>
      <h1>{data.title}</h1>
      {data.dek && <p class="dek">{data.dek}</p>}
      {!isStub && (
        <div class="byline">
          <div>Written by<br /><strong>{data.author ?? <span class="verify">[Author name]</span>}</strong></div>
          <div>Reviewed by<br /><strong>{data.reviewer ? `${data.reviewer.name}, ${data.reviewer.credentials}` : <><span class="verify">[Name]</span>, licensed mortgage adviser</>}</strong></div>
          <div>Last reviewed<br /><strong>{data.lastReviewed ? fmt(data.lastReviewed) : <span class="verify">[date]</span>}</strong></div>
        </div>
      )}
    </div>
  </header>

  {isStub ? (
    <div class="container stub prose"><Content /><p><a class="btn" href="/get-in-touch/">Request a call back</a></p></div>
  ) : (
    <div class="container layout">
      <article class="prose">
        <details class="mobile-toc">
          <summary>On this page</summary>
          <nav aria-label="On this page (mobile)">{toc.map((t) => <a href={`#${t.id}`}>{t.text}</a>)}</nav>
        </details>

        <Content />

        {faq.length > 0 && (
          <section aria-labelledby="faq">
            <h2 id="faq">Frequently asked questions</h2>
            <div class="faq">
              {faq.map((f, i) => (
                <details open={i === 0}><summary>{f.q}</summary><p>{f.a}</p></details>
              ))}
            </div>
          </section>
        )}

        {data.sources.length > 0 && (
          <section aria-labelledby="sources" class="sources">
            <h2 id="sources">Sources</h2>
            <ol>
              {data.sources.map((s) => (
                <li>{s.url ? <a href={s.url}>{s.label}</a> : s.label}{s.verify && <> <span class="verify">VERIFY: {s.verify}</span></>}</li>
              ))}
            </ol>
            <p class="disc">This guide is general information and not mortgage advice. My Dutch Door is an introduction service; we don't give advice and we're not a lender.</p>
          </section>
        )}
      </article>

      <aside class="side" aria-label="On this page and contact">
        <nav aria-labelledby="toc" class="toc">
          <h2 id="toc">On this page</h2>
          {toc.map((t) => <a href={`#${t.id}`} data-toc={t.id}>{t.text}</a>)}
        </nav>
        <div class="side-cta">
          <h2>Talk to an independent adviser</h2>
          <p>Leave your name, email and phone number. An independent mortgage adviser contacts you.</p>
          <a class="btn" href="/get-in-touch/">Request a call back</a>
          <p class="fine">My Dutch Door only makes the introduction. We don't give advice.</p>
        </div>
      </aside>
    </div>
  )}

  {related.length > 0 && (
    <section class="related" aria-labelledby="related">
      <div class="container">
        <h2 id="related">Keep reading</h2>
        <div class="rel-grid">
          {related.map((r) => <a href={`/guides/${r.id}/`}><span class="rc">{r.data.category}</span><span class="rt">{r.data.title}</span></a>)}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<script>
  // Highlight the current section in the sidebar table of contents.
  const links = new Map<string, HTMLElement>();
  document.querySelectorAll<HTMLElement>('[data-toc]').forEach((a) => links.set(a.dataset.toc!, a));
  if (links.size && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          links.forEach((a) => a.removeAttribute('aria-current'));
          links.get(e.target.id)?.setAttribute('aria-current', 'true');
        }
      }
    }, { rootMargin: '0px 0px -70% 0px' });
    links.forEach((_, id) => { const el = document.getElementById(id); if (el) io.observe(el); });
  }
</script>

<style>
  .art-head { background: var(--paper); padding: 28px 0 40px; border-bottom: 1px solid var(--line); }
  .head-in { display: flex; flex-direction: column; gap: 16px; }
  .head-in > * { max-width: 860px; }
  .crumbs { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; font-size: 14px; color: var(--muted); }
  .crumbs a { display: inline-flex; align-items: center; min-height: 44px; }
  .cat { align-self: flex-start; font-size: 13px; font-weight: 600; padding: 3px 10px; border-radius: 999px; background: var(--accent-soft); color: var(--link); }
  h1 { font-size: clamp(32px, 5vw, 48px); line-height: 1.08; }
  .dek { font-size: 20px; color: var(--ink-2); line-height: 1.5; }
  .byline { display: flex; flex-wrap: wrap; gap: 12px 32px; font-size: 14px; color: var(--muted); margin-top: 4px; }
  .byline strong { color: var(--ink); font-weight: 600; }

  .layout { display: grid; gap: 48px; grid-template-columns: minmax(0, 1fr); padding-block: 40px 64px; }
  @media (min-width: 1000px) { .layout { grid-template-columns: minmax(0, 1fr) 300px; gap: 64px; } }
  .stub { padding-block: 40px 64px; max-width: 760px; }

  .prose { font-size: 18px; line-height: 1.7; max-width: 720px; }
  .prose :global(h2) { font-size: 28px; margin: 48px 0 14px; scroll-margin-top: 24px; }
  .prose :global(p), .prose :global(ul), .prose :global(ol), .prose :global(table) { margin: 0 0 16px; }
  .prose :global(ul), .prose :global(ol) { padding-left: 22px; }
  .prose :global(li) { margin-bottom: 6px; }
  .prose :global(.short-answer) { background: var(--accent-soft); border: 1px solid #f6d8c2; border-radius: 16px; padding: 24px 28px; margin-bottom: 8px; }
  .prose :global(.short-answer h2) { margin: 0 0 10px; font-size: 22px; }
  .prose :global(.short-answer p:last-child) { margin: 0; font-size: 15px; color: var(--ink-2); }
  .prose :global(table) { width: 100%; border-collapse: collapse; font-size: 16px; line-height: 1.5; display: block; overflow-x: auto; }
  .prose :global(th), .prose :global(td) { text-align: left; padding: 12px 14px; border: 1px solid var(--line); vertical-align: top; }
  .prose :global(th) { background: var(--paper); }
  .prose :global(.cta-band) { background: var(--ink); color: #fff; border-radius: 16px; padding: 24px 28px; margin: 32px 0; display: flex; flex-wrap: wrap; gap: 16px 24px; align-items: center; justify-content: space-between; }
  .prose :global(.cta-band p) { margin: 0; flex: 1 1 260px; }
  .prose :global(.cta-band .btn) { color: #fff; }

  .mobile-toc { border: 1px solid var(--line); border-radius: 12px; margin-bottom: 24px; background: var(--paper); font-size: 16px; line-height: 1.4; }
  .mobile-toc summary { cursor: pointer; font-weight: 600; min-height: 48px; display: flex; align-items: center; padding: 0 16px; }
  .mobile-toc nav { display: flex; flex-direction: column; padding: 0 16px 12px; }
  .mobile-toc a { min-height: 44px; display: flex; align-items: center; }
  @media (min-width: 1000px) { .mobile-toc { display: none; } }

  .side { display: none; }
  @media (min-width: 1000px) { .side { display: flex; flex-direction: column; gap: 24px; position: sticky; top: 24px; align-self: start; } }
  .toc { display: flex; flex-direction: column; border-left: 2px solid var(--line); }
  .toc h2 { font-size: 15px; font-family: var(--font-body); font-weight: 600; color: var(--muted); padding: 0 0 8px 16px; }
  .toc a { display: flex; align-items: center; min-height: 44px; padding-left: 16px; margin-left: -2px; border-left: 2px solid transparent; color: var(--ink-2); text-decoration: none; font-size: 15px; line-height: 1.3; }
  .toc a:hover { color: var(--ink); }
  .toc a[aria-current] { border-left-color: var(--accent); color: var(--ink); font-weight: 600; }
  .side-cta { border: 1px solid var(--line); border-radius: 16px; padding: 22px; display: flex; flex-direction: column; gap: 12px; box-shadow: 0 1px 2px rgba(19,35,58,.06); }
  .side-cta h2 { font-size: 20px; }
  .side-cta p { font-size: 15px; color: var(--ink-2); line-height: 1.5; }
  .side-cta .fine { font-size: 13px; color: var(--muted); }

  .faq { display: flex; flex-direction: column; gap: 10px; }
  .faq details { border: 1px solid var(--line); border-radius: 12px; padding: 0 18px; }
  .faq summary { cursor: pointer; font-weight: 600; font-size: 17px; min-height: 56px; display: flex; align-items: center; }
  .faq p { padding-bottom: 6px; color: var(--ink-2); }
  .sources ol { font-size: 15px; color: var(--ink-2); }
  .sources .disc { font-size: 14px; color: var(--muted); }

  .related { background: var(--paper); padding: 48px 0; border-top: 1px solid var(--line); }
  .related h2 { font-size: 28px; margin-bottom: 20px; }
  .rel-grid { display: grid; gap: 16px; grid-template-columns: 1fr; }
  @media (min-width: 720px) { .rel-grid { grid-template-columns: repeat(3, 1fr); } }
  .rel-grid a { background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 20px; text-decoration: none; color: var(--ink); display: flex; flex-direction: column; gap: 6px; }
  .rel-grid a:hover { border-color: var(--accent); }
  .rc { font-size: 13px; font-weight: 600; color: var(--link); }
  .rt { font-family: var(--font-head); font-weight: 700; font-size: 18px; line-height: 1.25; }
</style>
