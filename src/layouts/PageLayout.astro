---
import BaseLayout from './BaseLayout.astro';
interface Props { title: string; heading: string; description: string; dek?: string; noindex?: boolean }
const { title, heading, description, dek, noindex = false } = Astro.props;
---
<BaseLayout title={`${title} | My Dutch Door`} {description} {noindex}>
  <section class="head"><div class="container inner">
    <h1>{heading}</h1>
    {dek && <p class="dek">{dek}</p>}
  </div></section>
  <div class="container body prose"><slot /></div>
</BaseLayout>
<style>
  .head { background: var(--paper); padding: 48px 0; border-bottom: 1px solid var(--line); }
  .inner { display: flex; flex-direction: column; gap: 12px; max-width: 800px; }
  h1 { font-size: clamp(32px, 5vw, 46px); }
  .dek { font-size: 19px; color: var(--ink-2); }
  .body { padding-block: 40px 72px; }
  .prose { max-width: 760px; font-size: 18px; line-height: 1.7; }
  .prose :global(h2) { font-size: 26px; margin: 40px 0 12px; }
  .prose :global(h3) { font-size: 20px; margin: 28px 0 8px; }
  .prose :global(p), .prose :global(ul), .prose :global(ol) { margin: 0 0 16px; }
  .prose :global(ul), .prose :global(ol) { padding-left: 22px; }
  .prose :global(li) { margin-bottom: 6px; }
  .prose :global(.note) { background: #fff1c2; color: #6b4a00; border-radius: 10px; padding: 12px 16px; font-size: 15px; }
</style>
